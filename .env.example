# Required: your Anthropic API key (or run `ant auth login` and omit this).
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ---
# JARVIS_MODEL=claude-opus-5
# JARVIS_SUBAGENT_MODEL=claude-opus-5
# JARVIS_EFFORT=high                 # low | medium | high | xhigh | max
# JARVIS_SUBAGENT_EFFORT=low
# JARVIS_MAX_TOKENS=64000
# JARVIS_THINKING=1                  # 1 = adaptive thinking on, 0 = off
# JARVIS_REFUSAL_FALLBACKS=1         # server-side fallback on a policy decline
# JARVIS_WEB_TOOLS=1                 # server-side web search + fetch

# Everything file/shell tools touch is confined to this directory.
# JARVIS_WORKSPACE=.
# JARVIS_DATA_DIR=~/.jarvis

# auto = run without asking, prompt = ask first, deny = refuse
# JARVIS_APPROVAL=prompt
# JARVIS_SHELL_TIMEOUT=60
# JARVIS_MAX_DEPTH=2
# JARVIS_MAX_ITERATIONS=40

# --- Voice ---
# JARVIS_WAKE_WORD=jarvis
# JARVIS_STT_MODEL=base.en
# JARVIS_TTS_BACKEND=auto            # auto | pyttsx3 | say | espeak | print

# --- Web ---
# JARVIS_WEB_HOST=127.0.0.1
# JARVIS_WEB_PORT=8765
